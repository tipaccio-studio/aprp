<Window x:Class="Aprp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Aprp.Models"
        xmlns:local="clr-namespace:Aprp"
        Title="aprp" Width="1360" Height="880" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/aprp.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

  <Window.Resources>
    <!-- ── Library card ─────────────────────────────────────── -->
    <DataTemplate x:Key="GameCard" DataType="{x:Type m:Game}">
      <Grid x:Name="Root" Width="156" Margin="9,9,9,14" Background="Transparent" Cursor="Hand"
            RenderTransformOrigin="0.5,0.5" ToolTip="{Binding Title}">
        <Grid.RenderTransform>
          <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Grid.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                        Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid.InputBindings>

        <StackPanel>
          <Grid Height="234">
            <!-- Frame + shadow, placeholder letter, cover, dim, badges -->
            <Border x:Name="Glow" CornerRadius="12" Background="{StaticResource AccentGradient}" Visibility="Collapsed">
              <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.85" Color="{StaticResource AccentColor}"/>
              </Border.Effect>
            </Border>
            <Border x:Name="Frame" CornerRadius="12" Background="{StaticResource PlaceholderBrush}"
                    BorderThickness="2" BorderBrush="Transparent">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="Black"/>
              </Border.Effect>
            </Border>
            <TextBlock x:Name="InitialText" Text="{Binding Initial}" FontSize="60" FontWeight="Bold" Foreground="#30FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <!-- Image (not ImageBrush): only Image repaints when a web download completes. -->
            <Image x:Name="CoverImage" Source="{Binding Cover, Converter={StaticResource Img}}" Stretch="UniformToFill" Margin="2"
                   Width="152" Height="230" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip>
                <RectangleGeometry Rect="0,0,152,230" RadiusX="10" RadiusY="10"/>
              </Image.Clip>
            </Image>
            <Border x:Name="Dim" CornerRadius="10" Margin="2" Background="#8C0B0E12" Visibility="Collapsed"/>

            <Border Width="26" Height="26" CornerRadius="13" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{Binding Platform, Converter={StaticResource Platform}, ConverterParameter=Brush}"
                    BorderBrush="#40FFFFFF" BorderThickness="1">
              <Viewbox Width="13" Height="13">
                <Path Data="{Binding Platform, Converter={StaticResource Platform}, ConverterParameter=Logo}" Fill="White"/>
              </Viewbox>
            </Border>

            <Border x:Name="RunningBadge" Visibility="Collapsed" Background="{StaticResource RunningBrush}"
                    CornerRadius="6" Padding="7,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock Text="{local:T PlayingBadge}" FontSize="10" FontWeight="Bold" Foreground="#06200F"/>
            </Border>

            <Button x:Name="PlayOverlay" Width="56" Height="56" Opacity="0" Cursor="Hand"
                    CommandParameter="{Binding}"
                    Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Grid>
                    <Ellipse Fill="{StaticResource AccentGradient}">
                      <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                      </Ellipse.Effect>
                    </Ellipse>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </ControlTemplate>
              </Button.Template>
              <Viewbox Width="22" Height="22">
                <Path x:Name="OverlayIcon" Data="{StaticResource PlayIcon}" Fill="White"/>
              </Viewbox>
            </Button>
          </Grid>

          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Margin="2,10,2,0"
                     TextTrimming="CharacterEllipsis"/>
          <DockPanel Margin="2,2,2,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding PlaytimeText}" FontSize="11.5" Margin="6,0,0,0"
                       Foreground="{StaticResource MutedBrush}" Visibility="{Binding HasPlaytime, Converter={StaticResource Vis}}"/>
            <TextBlock x:Name="Subtitle" Text="{Binding Platform, Converter={StaticResource Platform}}"
                       FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </StackPanel>
      </Grid>

      <DataTemplate.Triggers>
        <EventTrigger SourceName="Root" RoutedEvent="MouseEnter">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.045" Duration="0:0:0.15"/>
              <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.045" Duration="0:0:0.15"/>
              <DoubleAnimation Storyboard.TargetName="PlayOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger SourceName="Root" RoutedEvent="MouseLeave">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetName="PlayOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentGradient}"/>
          <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Source}" Value="modrinth">
          <Setter TargetName="Subtitle" Property="Text" Value="Modrinth"/>
          <Setter TargetName="Subtitle" Property="Foreground" Value="{StaticResource ModrinthBrush}"/>
          <Setter TargetName="CoverImage" Property="Stretch" Value="Uniform"/>
          <Setter TargetName="CoverImage" Property="Margin" Value="30"/>
          <Setter TargetName="CoverImage" Property="Width" Value="96"/>
          <Setter TargetName="CoverImage" Property="Height" Value="96"/>
          <Setter TargetName="CoverImage" Property="Clip" Value="{x:Null}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Installed}" Value="False">
          <Setter TargetName="Dim" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Subtitle" Property="Text" Value="{local:T NotInstalled}"/>
          <Setter TargetName="OverlayIcon" Property="Data" Value="{StaticResource DownloadIcon}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRunning}" Value="True">
          <Setter TargetName="RunningBadge" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Subtitle" Property="Text" Value="{local:T Playing}"/>
          <Setter TargetName="Subtitle" Property="Foreground" Value="{StaticResource RunningBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Sidebar nav entry: Tag = icon geometry -->
    <DataTemplate x:Key="NavIcon">
      <Viewbox Width="17" Height="17">
        <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
      </Viewbox>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="256"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ══ Sidebar ═══════════════════════════════════════════ -->
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,26,24,30">
          <Image Source="Assets/aprp.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="aprp" FontSize="22" FontWeight="Bold" Margin="0,-4,0,0"/>
            <TextBlock Text="{local:T Tagline}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
          <!-- Language picker -->
          <Grid Margin="0,0,0,14">
            <ToggleButton x:Name="LangButton" Style="{StaticResource LangToggle}" IsChecked="{Binding IsLanguageMenuOpen}"
                          ToolTip="{local:T Language}">
              <DockPanel>
                <Path DockPanel.Dock="Right" Data="M0 0 L4 4 L8 0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Viewbox Width="15" Height="15" Margin="0,0,10,0">
                  <Path Data="{StaticResource GlobeIcon}" Fill="{StaticResource SubtleBrush}"/>
                </Viewbox>
                <TextBlock Text="{Binding LanguageName, Source={x:Static local:Loc.Instance}}" VerticalAlignment="Center"/>
              </DockPanel>
            </ToggleButton>
            <Popup IsOpen="{Binding IsLanguageMenuOpen}" PlacementTarget="{Binding ElementName=LangButton}"
                   Placement="Top" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True"
                   Width="{Binding ActualWidth, ElementName=LangButton}" PopupAnimation="Fade">
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,0,0,4">
                <ItemsControl ItemsSource="{Binding Languages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource MenuButton}" Content="{Binding Name}" CommandParameter="{Binding Code}"
                              Command="{Binding DataContext.SetLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Popup>
          </Grid>

          <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                     TextWrapping="Wrap" Margin="4,0,4,12"/>
          <Button Style="{StaticResource SecondaryButton}" Command="{Binding RescanCommand}" Padding="14,11">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="15" Height="15" Margin="0,0,9,0">
                <Path Data="{StaticResource RefreshIcon}" Fill="{StaticResource TextBrush}"/>
              </Viewbox>
              <TextBlock Text="{local:T Refresh}"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel>
          <TextBlock Text="{local:T Library}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="28,0,0,8"/>
          <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding Platform, Converter={StaticResource Is}, ConverterParameter=all}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource CountPill}"><TextBlock Text="{Binding AllCount}"/></Border>
              <ContentControl Content="{StaticResource AllLogo}" ContentTemplate="{StaticResource NavIcon}" Margin="0,0,14,0"/>
              <TextBlock Text="{local:T AllGames}" VerticalAlignment="Center"/>
            </DockPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding Platform, Converter={StaticResource Is}, ConverterParameter=recent}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource CountPill}"><TextBlock Text="{Binding RecentCount}"/></Border>
              <ContentControl Content="{StaticResource ClockIcon}" ContentTemplate="{StaticResource NavIcon}" Margin="0,0,14,0"/>
              <TextBlock Text="{local:T Recent}" VerticalAlignment="Center"/>
            </DockPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding Platform, Converter={StaticResource Is}, ConverterParameter=steam}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource CountPill}"><TextBlock Text="{Binding SteamCount}"/></Border>
              <ContentControl Content="{StaticResource SteamLogo}" ContentTemplate="{StaticResource NavIcon}" Margin="0,0,14,0"/>
              <TextBlock Text="Steam" VerticalAlignment="Center"/>
            </DockPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding Platform, Converter={StaticResource Is}, ConverterParameter=epic}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource CountPill}"><TextBlock Text="{Binding EpicCount}"/></Border>
              <ContentControl Content="{StaticResource EpicLogo}" ContentTemplate="{StaticResource NavIcon}" Margin="0,0,14,0"/>
              <TextBlock Text="Epic Games" VerticalAlignment="Center"/>
            </DockPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding Platform, Converter={StaticResource Is}, ConverterParameter=xbox}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource CountPill}"><TextBlock Text="{Binding XboxCount}"/></Border>
              <ContentControl Content="{StaticResource XboxLogo}" ContentTemplate="{StaticResource NavIcon}" Margin="0,0,14,0"/>
              <TextBlock Text="Xbox" VerticalAlignment="Center"/>
            </DockPanel>
          </RadioButton>

          <CheckBox Style="{StaticResource ToggleSwitch}" Content="{local:T InstalledOnly}" IsChecked="{Binding InstalledOnly}"
                    Margin="28,22,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ══ Main ══════════════════════════════════════════════ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="380"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Hero: selected game -->
      <Grid DataContext="{Binding SelectedGame}" ClipToBounds="True">
        <Rectangle Fill="{StaticResource PlaceholderBrush}"/>
        <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Center"
               Source="{Binding Banner, Converter={StaticResource Img}, ConverterParameter=1920, NotifyOnTargetUpdated=True}">
          <Image.Triggers>
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Image.Triggers>
        </Image>
        <Rectangle Fill="{StaticResource HeroFadeLeft}"/>
        <Rectangle Fill="{StaticResource HeroFadeBottom}"/>

        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="700" Margin="44,0,44,26"
                    Visibility="{Binding DataContext.SelectedGame, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
          <Image Source="{Binding Logo, Converter={StaticResource Img}, ConverterParameter=800}"
                 MaxHeight="112" MaxWidth="420" HorizontalAlignment="Left" Stretch="Uniform"
                 Visibility="{Binding Logo, Converter={StaticResource Vis}}">
            <Image.Effect>
              <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.7" Color="Black"/>
            </Image.Effect>
          </Image>
          <TextBlock Text="{Binding Title}" FontSize="40" FontWeight="Bold" TextWrapping="Wrap"
                     Visibility="{Binding Logo, Converter={StaticResource Vis}, ConverterParameter=Invert}">
            <TextBlock.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.8" Color="Black"/>
            </TextBlock.Effect>
          </TextBlock>

          <!-- Meta chips -->
          <WrapPanel Margin="0,16,0,0">
            <Border CornerRadius="7" Padding="9,4" Margin="0,0,8,6"
                    Background="{Binding Platform, Converter={StaticResource Platform}, ConverterParameter=Brush}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                  <Path Data="{Binding Platform, Converter={StaticResource Platform}, ConverterParameter=Logo}" Fill="White"/>
                </Viewbox>
                <TextBlock Text="{Binding Platform, Converter={StaticResource Platform}}" FontSize="12" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border CornerRadius="7" Padding="9,4" Margin="0,0,8,6" Background="#33FFFFFF">
              <TextBlock FontSize="12" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{local:T Installed}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Installed}" Value="False">
                        <Setter Property="Text" Value="{local:T NotInstalled}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Text" Value="{local:T Playing}"/>
                        <Setter Property="Foreground" Value="{StaticResource RunningBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
            <Border CornerRadius="7" Padding="9,4" Margin="0,0,8,6" Background="#33FFFFFF"
                    Visibility="{Binding SizeBytes, Converter={StaticResource Vis}}">
              <TextBlock Text="{Binding SizeBytes, Converter={StaticResource Bytes}}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <Border CornerRadius="7" Padding="9,4" Margin="0,0,8,6" Background="{StaticResource ModrinthBrush}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Source}" Value="modrinth">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="13" Height="13" Margin="0,0,7,0"><Path Data="{StaticResource ModrinthLogo}" Fill="White"/></Viewbox>
                <TextBlock Text="Modrinth" FontSize="12" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border CornerRadius="7" Padding="9,4" Margin="0,0,8,6" Background="#33FFFFFF"
                    Visibility="{Binding HasPlaytime, Converter={StaticResource Vis}}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="12" Height="12" Margin="0,0,6,0"><Path Data="{StaticResource ClockIcon}" Fill="{StaticResource TextBrush}"/></Viewbox>
                <TextBlock Text="{Binding PlaytimeText}" FontSize="12" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding LastPlayedText}" FontSize="12.5" Foreground="{StaticResource SubtleBrush}"
                       VerticalAlignment="Center" Margin="2,0,10,6" Visibility="{Binding HasLastPlayed, Converter={StaticResource Vis}}"/>
            <TextBlock Text="{Binding Developer}" FontSize="12.5" Foreground="{StaticResource SubtleBrush}"
                       VerticalAlignment="Center" Margin="4,0,0,6"/>
          </WrapPanel>

          <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubtleBrush}" FontSize="14"
                     LineHeight="21" TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="63" Margin="0,6,0,0"/>

          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                  <Setter Property="Content">
                    <Setter.Value>
                      <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0"><Path Data="{StaticResource PlayIcon}" Fill="White"/></Viewbox>
                        <TextBlock Text="{local:T Play}"/>
                      </StackPanel>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Installed}" Value="False">
                      <Setter Property="Content">
                        <Setter.Value>
                          <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0"><Path Data="{StaticResource DownloadIcon}" Fill="White"/></Viewbox>
                            <TextBlock Text="{local:T Install}"/>
                          </StackPanel>
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding Installed, Converter={StaticResource Vis}}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="15" Height="15" Margin="0,0,9,0"><Path Data="{StaticResource FolderIcon}" Fill="{StaticResource TextBrush}"/></Viewbox>
                <TextBlock Text="{local:T OpenFolder}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Library header -->
      <DockPanel Grid.Row="1" Margin="44,10,44,6">
        <TextBox DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Tag="{local:T Search}" Width="300" Height="40"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{local:T YourLibrary}" FontSize="20" FontWeight="Bold"/>
          <Border Style="{StaticResource CountPill}" Margin="12,2,0,0">
            <TextBlock Text="{Binding VisibleCount}"/>
          </Border>
        </StackPanel>
      </DockPanel>

      <TextBlock Grid.Row="2" Text="{local:T Empty}" FontSize="16" Foreground="{StaticResource MutedBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                 Visibility="{Binding VisibleCount, Converter={StaticResource Vis}, ConverterParameter=Invert}"/>

      <!-- Library grid -->
      <ListBox Grid.Row="2" ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}"
               ItemTemplate="{StaticResource GameCard}" ItemContainerStyle="{StaticResource CardContainer}"
               Background="Transparent" BorderThickness="0" Padding="34,4,30,20" Foreground="{StaticResource TextBrush}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
    </Grid>
  </Grid>
</Window>
