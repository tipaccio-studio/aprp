<Application x:Class="Aprp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aprp"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Assets/PlatformLogos.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- ── Palette ──────────────────────────────────────────── -->
      <Color x:Key="BgColor">#0B0E12</Color>
      <SolidColorBrush x:Key="WindowBrush"  Color="{StaticResource BgColor}"/>
      <SolidColorBrush x:Key="SidebarBrush" Color="#11141B"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#171B24"/>
      <SolidColorBrush x:Key="HoverBrush"   Color="#1F2430"/>
      <SolidColorBrush x:Key="LineBrush"    Color="#232937"/>
      <SolidColorBrush x:Key="TextBrush"    Color="#F1F3F8"/>
      <SolidColorBrush x:Key="SubtleBrush"  Color="#C9CFDB"/>
      <SolidColorBrush x:Key="MutedBrush"   Color="#8590A6"/>
      <SolidColorBrush x:Key="AccentBrush"  Color="#7C5CFF"/>
      <SolidColorBrush x:Key="RunningBrush" Color="#2ECC71"/>
      <Color x:Key="AccentColor">#7C5CFF</Color>

      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C5CFF" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A2F4A" Offset="0"/>
        <GradientStop Color="#151922" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroFadeLeft" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F20B0E12" Offset="0"/>
        <GradientStop Color="#A60B0E12" Offset="0.45"/>
        <GradientStop Color="#000B0E12" Offset="0.85"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroFadeBottom" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#400B0E12" Offset="0"/>
        <GradientStop Color="#000B0E12" Offset="0.35"/>
        <GradientStop Color="#FF0B0E12" Offset="1"/>
      </LinearGradientBrush>

      <!-- Icons (24×24) -->
      <Geometry x:Key="AllLogo">M3 3h7.5v7.5H3z M13.5 3H21v7.5h-7.5z M3 13.5h7.5V21H3z M13.5 13.5H21V21h-7.5z</Geometry>
      <Geometry x:Key="PlayIcon">M7 4.5v15c0 .8.9 1.3 1.6.8l11.3-7.5c.6-.4.6-1.2 0-1.6L8.6 3.7C7.9 3.2 7 3.7 7 4.5z</Geometry>
      <Geometry x:Key="DownloadIcon">M11 3h2v10.2l3.6-3.6 1.4 1.4-6 6-6-6 1.4-1.4 3.6 3.6z M4 19h16v2H4z</Geometry>
      <Geometry x:Key="FolderIcon">M3 5.5C3 4.7 3.7 4 4.5 4h5l2 2.5h8c.8 0 1.5.7 1.5 1.5v10.5c0 .8-.7 1.5-1.5 1.5h-15C3.7 20 3 19.3 3 18.5z</Geometry>
      <Geometry x:Key="RefreshIcon">M12 4a8 8 0 0 1 7.4 5H17v2h6V5h-2v2.3A10 10 0 0 0 2 12h2a8 8 0 0 1 8-8z M20 12a8 8 0 0 1-15.4 3H7v-2H1v6h2v-2.3A10 10 0 0 0 22 12z</Geometry>
      <Geometry x:Key="ClockIcon">M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm1 3v4.6l3.4 2-1 1.7L11 12.7V7z</Geometry>
      <SolidColorBrush x:Key="ModrinthBrush" Color="#00AF5C"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>
      <SolidColorBrush x:Key="StudioBrush" Color="#F05368"/>
      <Geometry x:Key="InfoIcon">M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm-1 7h2v6h-2zm0-4h2v2h-2z</Geometry>
      <Geometry x:Key="CloseIcon">M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4z</Geometry>
      <Geometry x:Key="ExternalIcon">M14 3h7v7h-2V6.4l-9.3 9.3-1.4-1.4L17.6 5H14zM5 5h6v2H5v12h12v-6h2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z</Geometry>

      <!-- Text link (Tag = optional URL for the tooltip) -->
      <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent"/>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Geometry x:Key="SearchIcon">M10 3a7 7 0 0 1 5.6 11.2l5.1 5.1-1.4 1.4-5.1-5.1A7 7 0 1 1 10 3zm0 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10z</Geometry>

      <local:ImageConverter x:Key="Img"/>
      <local:PlatformConverter x:Key="Platform"/>
      <local:BytesConverter x:Key="Bytes"/>
      <local:VisibilityConverter x:Key="Vis"/>
      <local:EqualsConverter x:Key="Is"/>

      <!-- ── Sidebar navigation ───────────────────────────────── -->
      <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Platform"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="12,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid>
                <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="14,10">
                  <ContentPresenter/>
                </Border>
                <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,9" HorizontalAlignment="Left"
                        Background="{StaticResource AccentGradient}" Visibility="Collapsed"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                  <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                  <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="CountPill" TargetType="Border">
        <Setter Property="Background" Value="#262C3A"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource SubtleBrush}"/>
      </Style>

      <!-- ── Buttons ──────────────────────────────────────────── -->
      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="28,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10">
                  <Border.Effect>
                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                  </Border.Effect>
                </Border>
                <Border x:Name="Shine" Background="White" CornerRadius="10" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Shine" Property="Opacity" Value="0.12"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Shine" Property="Opacity" Value="0.22"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10"
                      BorderBrush="#26FFFFFF" BorderThickness="1">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Geometry x:Key="GlobeIcon">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-3a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8 8 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4zm.8 2h3a15.7 15.7 0 0 0 1.4 3.6A8 8 0 0 1 5.1 16zm3-8h-3a8 8 0 0 1 4.4-3.6A15.7 15.7 0 0 0 8.1 8zM12 20c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h3a8 8 0 0 1-4.4 3.6zm1.7-5.6a16.5 16.5 0 0 0 0-4h3.4a8 8 0 0 1 0 4z</Geometry>

      <!-- ── Language picker ──────────────────────────────────── -->
      <Style x:Key="LangToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="12,8"
                      BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                  <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MenuButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,7">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Toggle switch ────────────────────────────────────── -->
      <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Grid Width="38" Height="22" VerticalAlignment="Center">
                  <Border x:Name="Track" CornerRadius="11" Background="#2B3242"/>
                  <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" Margin="3,0" HorizontalAlignment="Left"/>
                </Grid>
                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradient}"/>
                  <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Search box (Tag = placeholder) ───────────────────── -->
      <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                      BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,0">
                <DockPanel>
                  <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                    <Path Data="{StaticResource SearchIcon}" Fill="{StaticResource MutedBrush}"/>
                  </Viewbox>
                  <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource MutedBrush}"
                               IsHitTestVisible="False" Visibility="Collapsed" Margin="2,0"/>
                    <ScrollViewer x:Name="PART_ContentHost"/>
                  </Grid>
                </DockPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Thin scrollbars ──────────────────────────────────── -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="4" Background="#33FFFFFF" Margin="3"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#66FFFFFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
              <ControlTemplate.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                  <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="12"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Card list items: no default selection chrome, the card draws its own. -->
      <Style x:Key="CardContainer" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <ContentPresenter/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
