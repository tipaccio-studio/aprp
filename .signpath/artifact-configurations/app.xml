<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": copy into the aprp project on signpath.io (slug: app).
     Round 1 of .github/workflows/release.yml: the GitHub artifact is a ZIP containing aprp.exe.
     Product name/version restrictions are required by SignPath Foundation. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="aprp.exe" product-name="aprp" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
