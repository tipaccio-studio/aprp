; aprp installer (Inno Setup 6). Built by build.ps1:
;   ISCC.exe /DAppVersion=0.2.0 installer\aprp.iss   ->  dist\aprp-setup-0.2.0.exe
;
; - Per-user install by default (no admin prompt); the user can choose "all users" instead.
; - Six languages; the chosen one is also saved as the app's UI language.
; - Banner/logo art is generated by tools/make_assets.py.

#ifndef AppVersion
  #define AppVersion "0.2.0"
#endif
#define AppName "aprp"
#define AppExe "aprp.exe"

[Setup]
AppId={{6B1C2F2E-5A3D-4C8E-9F1A-A7B2C3D4E5F6}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=aprp
AppCopyright=aprp
VersionInfoVersion={#AppVersion}
VersionInfoDescription={#AppName} Setup
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
OutputDir=..\dist
OutputBaseFilename=aprp-setup-{#AppVersion}
SetupIconFile=..\src\Aprp.App\Assets\aprp.ico
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
WizardStyle=modern
WizardSizePercent=110
WizardImageFile=art\wizard-100.bmp,art\wizard-150.bmp,art\wizard-200.bmp
WizardSmallImageFile=art\small-100.bmp,art\small-150.bmp,art\small-200.bmp
WizardImageStretch=no
; Inno 6 hides the welcome page by default; it's where the aprp banner shows.
DisableWelcomePage=no
ShowLanguageDialog=yes
LanguageDetectionMethod=uilanguage
CloseApplications=yes
RestartApplications=no
Compression=lzma2/ultra64
SolidCompression=yes

[Languages]
Name: "it"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "en"; MessagesFile: "compiler:Default.isl"
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "fr"; MessagesFile: "compiler:Languages\French.isl"
Name: "de"; MessagesFile: "compiler:Languages\German.isl"
Name: "pt"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"

[Messages]
it.WelcomeLabel2=Questo programma installerà [name/ver] sul tuo computer.%n%nTutti i tuoi giochi di Steam, Epic Games e Xbox in un'unica libreria, con copertine, descrizioni e tempo di gioco.
en.WelcomeLabel2=This will install [name/ver] on your computer.%n%nAll your Steam, Epic Games and Xbox games in one library, with artwork, descriptions and playtime.
es.WelcomeLabel2=Se instalará [name/ver] en tu equipo.%n%nTodos tus juegos de Steam, Epic Games y Xbox en una sola biblioteca, con portadas, descripciones y tiempo de juego.
fr.WelcomeLabel2=Cet assistant va installer [name/ver] sur votre ordinateur.%n%nTous vos jeux Steam, Epic Games et Xbox dans une seule bibliothèque, avec jaquettes, descriptions et temps de jeu.
de.WelcomeLabel2=Hiermit wird [name/ver] auf deinem Computer installiert.%n%nAlle deine Spiele von Steam, Epic Games und Xbox in einer Bibliothek – mit Covern, Beschreibungen und Spielzeit.
pt.WelcomeLabel2=Isto instalará o [name/ver] no seu computador.%n%nTodos os seus jogos da Steam, Epic Games e Xbox em uma única biblioteca, com capas, descrições e tempo de jogo.

[CustomMessages]
it.AppComment=Tutti i tuoi giochi in un'unica libreria
en.AppComment=All your games in one library
es.AppComment=Todos tus juegos en una sola biblioteca
fr.AppComment=Tous vos jeux dans une seule bibliothèque
de.AppComment=Alle deine Spiele in einer Bibliothek
pt.AppComment=Todos os seus jogos em uma única biblioteca
it.StartWithWindows=Avvia aprp all'accesso a Windows
en.StartWithWindows=Start aprp when I sign in to Windows
es.StartWithWindows=Iniciar aprp al iniciar sesión en Windows
fr.StartWithWindows=Lancer aprp à l'ouverture de session Windows
de.StartWithWindows=aprp bei der Windows-Anmeldung starten
pt.StartWithWindows=Iniciar o aprp ao entrar no Windows
it.RemoveData=Vuoi eliminare anche la libreria salvata, le immagini e le impostazioni di aprp?
en.RemoveData=Do you also want to delete aprp's saved library, artwork cache and settings?
es.RemoveData=¿Quieres eliminar también la biblioteca guardada, las imágenes y la configuración de aprp?
fr.RemoveData=Voulez-vous aussi supprimer la bibliothèque enregistrée, le cache d'images et les réglages d'aprp ?
de.RemoveData=Sollen auch die gespeicherte Bibliothek, der Bild-Cache und die Einstellungen von aprp gelöscht werden?
pt.RemoveData=Deseja excluir também a biblioteca salva, o cache de imagens e as configurações do aprp?

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "startup"; Description: "{cm:StartWithWindows}"; Flags: unchecked

[Files]
Source: "..\dist\{#AppExe}"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"; Comment: "{cm:AppComment}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Comment: "{cm:AppComment}"; Tasks: desktopicon

[Registry]
; The language picked in the installer becomes the app's UI language (aprp reads HKCU, then HKLM).
Root: HKA; Subkey: "Software\aprp"; ValueType: string; ValueName: "Language"; ValueData: "{language}"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "aprp"; ValueData: """{app}\{#AppExe}"""; Tasks: startup; Flags: uninsdeletevalue

[Run]
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; The scanner extracted from aprp.exe on first run.
Type: filesandordirs; Name: "{localappdata}\aprp\bin"

[Code]
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  { Library cache, artwork metadata and settings are kept unless the user says otherwise (silent: kept). }
  if CurUninstallStep = usPostUninstall then
    if SuppressibleMsgBox(CustomMessage('RemoveData'), mbConfirmation, MB_YESNO, IDNO) = IDYES then
    begin
      DelTree(ExpandConstant('{localappdata}\aprp'), True, True, True);
      RegDeleteKeyIncludingSubkeys(HKEY_CURRENT_USER, 'Software\aprp');
    end;
end;
